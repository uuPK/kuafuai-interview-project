# Copy to .env locally. Empty service fields are placeholders; never commit credentials.
APP_NAME=每日 AI 新闻助手
DATA_DIR=./data

# DeepSeek: fill from your account before live integration tests.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4096

# Bocha: confirm the endpoint in your provider console.
BOCHA_SEARCH_URL=
BOCHA_API_KEY=

# SMTP: username/password may be empty for a local unauthenticated test server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TEST_RECIPIENT=

# Session secret must have at least 32 characters before auth is enabled.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400

# External requests: at most three attempts, including the first request.
REQUEST_TIMEOUT_SECONDS=30
EXTERNAL_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=1
# Longer waits are saved as waiting_retry; zero defers every retry.
RETRY_INLINE_MAX_SECONDS=5
MAX_REDIRECTS=5
MAX_DOWNLOAD_BYTES=2000000

# Per-run budgets: retries consume model request budget; persist before attempting.
MAX_MODEL_REQUESTS=15
MAX_SEARCH_CALLS=8
MAX_FETCH_CALLS=12
MAX_TOOL_CALLS=50
RUN_TIMEOUT_SECONDS=600
MAX_TOOL_RESULT_CHARS=12000
MAX_MODEL_INPUT_CHARS=120000
MAX_MODEL_RESPONSE_BYTES=2000000
# Per citation: preserve full adjacent paragraphs; reject oversized context instead of truncating.
MAX_REVIEW_CONTEXT_CHARS=8000

# Worker: lease must be at least three heartbeat intervals. Restart after edits.
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_POLL_SECONDS=1

# Task materials and scratch notes. Source snapshots remain immutable.
MAX_MATERIAL_FILE_BYTES=16100000
MAX_MATERIAL_SCAN_BYTES=32200000
MAX_MATERIAL_FILES=200
MAX_NOTE_CHARS=50000
# Build docker/tool/Dockerfile first; the tool never pulls an image automatically.
BASH_IMAGE=daily-ai-news-tools:local
# Empty selects the local Linux socket or Windows Docker Desktop Linux named pipe.
BASH_DOCKER_HOST=
BASH_TIMEOUT_SECONDS=10
BASH_OUTPUT_BYTES=24000

# Trusted local JSON source catalog; empty leaves RSS unavailable. Restart after edits.
RSS_SOURCES_FILE=
MAX_RSS_ENTRIES=500
